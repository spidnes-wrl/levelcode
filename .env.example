# LevelCode Environment Variables
# Copy this file to .env.local and fill in real values.

# Core
NEXT_PUBLIC_APP_NAME=LevelCode
NEXT_PUBLIC_APP_URL=http://localhost:3000

# AI providers (example)
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# GOOGLE_API_KEY=
# DEEPSEEK_API_KEY=
# XAI_API_KEY=

# External integrations
# SUPABASE_URL=
# SUPABASE_ANON_KEY=
# SUPABASE_SERVICE_ROLE_KEY=

# Optional analytics / telemetry
# NEXT_PUBLIC_POSTHOG_KEY=
# NEXT_PUBLIC_POSTHOG_HOST=

# Optional internal tooling
# LEVELCODE_MCP_URL=
