# LevelCode — public application configuration
NEXT_PUBLIC_APP_NAME=LevelCode
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Supabase — use the LevelCode project URL and publishable key.
# These values are public identifiers; database access must be protected by RLS.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server-only secrets (never prefix these with NEXT_PUBLIC_).
# Add only when a trusted server integration requires them.
